{
  "name": "@plaza/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && concurrently -k \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "pnpm --filter @plaza/shared build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "@plaza/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "mongodb": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^5.1.0"
  }
}
